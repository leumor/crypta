manifest.version=1
app.id=mail-prototype
app.name=Mail Prototype (experimental)
app.version=${appVersion}
api.minimumVersion=26
api.maximumTestedVersion=26
api.targetStability=experimental
api.experimentalCapabilitiesAccepted=true
app.exec=bin/mail-prototype.sh
app.ui.mode=static
app.ui.entry=static/index.html
app.permissions=mail.control,vault.identities.read,vault.identities.create,vault.mail.sign,vault.mail.open,vault.mail.storage,app.data.read,app.data.write,queue.read,queue.write,content.insert.app-document,content.fetch
permissions.rationale.mail.control=Operate only the own experimental Mail worker through fixed bounded commands including explicit same-key contact renewal.
permissions.rationale.vault.identities.read=Find retained app-owned mail identity metadata without exposing private keys.
permissions.rationale.vault.identities.create=Create dedicated app-owned signing recipient and local-storage identities.
permissions.rationale.vault.mail.sign=Sign validated mail contact cards and inner messages only from the authenticated worker.
permissions.rationale.vault.mail.open=Authenticate and open the fixed experimental recipient envelope only from the worker.
permissions.rationale.vault.mail.storage=Seal and open app-owned private state in a separate local-storage domain.
permissions.rationale.app.data.read=Restore opaque encrypted app-owned mailbox state.
permissions.rationale.app.data.write=Atomically persist encrypted contacts drafts mailbox replay and outbox state.
permissions.rationale.queue.read=Inspect explicit encrypted insert progress without claiming delivery.
permissions.rationale.queue.write=Queue and retry only committed immutable encrypted envelopes.
permissions.rationale.content.insert.app-document=Insert generated encrypted envelopes without local file authority.
permissions.rationale.content.fetch=Fetch only an explicitly approved bounded Crypta CHK reference.
app.beta.readiness=experimental
app.beta.qualityLevel=prototype
app.beta.support.owner=crypta-core
app.beta.support.uri=https://github.com/crypta-network/cryptad/issues
app.beta.support.diagnostics=redacted-summary-only
app.beta.ui.emptyState=true
app.beta.ui.errorState=true
app.beta.ui.retryAction=true
app.beta.ui.recoveryAction=true
app.beta.appData=durable-limited
app.beta.backupRestore=same-vault-only
app.beta.exportSupported=supported
app.beta.importSupported=supported
app.beta.migrationDryRunSupported=not-applicable
app.beta.accessibility=unobserved
app.beta.uiConsistency=unobserved
app.beta.diagnostics=redacted-summary-only
sandbox.mode=restricted-process
sandbox.required=false
app.restart.policy=never
quota.data.bytes=1048576
quota.cache.bytes=1048576
app.data.schema.current=1
app.data.schema.namespaces=mail-state
app.data.schema.namespace.mail-state.current=1
