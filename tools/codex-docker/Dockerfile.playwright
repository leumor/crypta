# syntax=docker/dockerfile:1
FROM node:24.20.0-trixie-slim

COPY --from=latest_versions /latest/versions.env /usr/local/share/codex-docker-versions.env

ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux; \
    set -a; \
    . /usr/local/share/codex-docker-versions.env; \
    set +a; \
    apt-get update; \
    apt-get upgrade -y; \
    apt-get install -y --no-install-recommends ca-certificates; \
    npm install --global "playwright@${PLAYWRIGHT_VERSION}"; \
    playwright install --with-deps; \
    useradd --create-home --shell /bin/bash pwuser; \
    chmod -R 0755 /ms-playwright /usr/local/share/codex-docker-versions.env; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

USER pwuser
WORKDIR /home/pwuser

EXPOSE 3000

CMD ["playwright", "run-server", "--port", "3000", "--host", "0.0.0.0"]
