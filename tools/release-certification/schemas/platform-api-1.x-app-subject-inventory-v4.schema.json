{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-api-1.x-app-subject-inventory-v4.schema.json",
  "title": "Private selected federation companion preserving original content authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "releaseId",
    "sourceCommit",
    "authorityRoots",
    "requiredAppIds",
    "subjects",
    "fixtureOnly",
    "inventoryDigest",
    "cohortPolicy",
    "cohortDigest",
    "producer",
    "baseInventoryVersion",
    "selectedFederation",
    "privacy",
    "cohortProjection"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "kind": {
      "const": "platform-api-1.x-app-subject-inventory"
    },
    "releaseId": {
      "$ref": "#/$defs/id"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "authorityRoots": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protectedRelease",
            "independentReproducibility",
            "catalogAuthority",
            "thirdPartyPilot",
            "federatedCatalog"
          ],
          "properties": {
            "protectedRelease": {
              "$ref": "#/$defs/digest"
            },
            "independentReproducibility": {
              "$ref": "#/$defs/digest"
            },
            "catalogAuthority": {
              "$ref": "#/$defs/digest"
            },
            "thirdPartyPilot": {
              "$ref": "#/$defs/digest"
            },
            "federatedCatalog": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maintenanceAppProducts",
            "thirdPartyPilot"
          ],
          "properties": {
            "maintenanceAppProducts": {
              "$ref": "#/$defs/digest"
            },
            "thirdPartyPilot": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "requiredAppIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "fixtureOnly": {
      "type": "boolean"
    },
    "inventoryDigest": {
      "$ref": "#/$defs/digest"
    },
    "cohortPolicy": {
      "enum": [
        "historical-seven",
        "current-eight-experimental-mail"
      ]
    },
    "cohortDigest": {
      "$ref": "#/$defs/digest"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "workflowPath",
        "environment",
        "runId",
        "runAttempt"
      ],
      "properties": {
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflowPath": {
          "const": ".github/workflows/stable-1.0-app-subject-projection.yml"
        },
        "environment": {
          "const": "stable-1-0-app-subject-projection"
        },
        "runId": {
          "type": "integer",
          "minimum": 1
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "baseInventoryVersion": {
      "enum": [
        2,
        3
      ]
    },
    "privacy": {
      "const": "private-local-selection"
    },
    "selectedFederation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "appId",
          "original",
          "contextId",
          "contextDigest",
          "generation",
          "nativeProjection"
        ],
        "properties": {
          "appId": {
            "$ref": "#/$defs/id"
          },
          "original": {
            "type": "object"
          },
          "contextId": {
            "$ref": "#/$defs/id"
          },
          "contextDigest": {
            "$ref": "#/$defs/digest"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "nativeProjection": {
            "type": "object",
            "required": [
              "schemaVersion",
              "federationSelection"
            ],
            "properties": {
              "schemaVersion": {
                "const": 3
              },
              "federationSelection": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "selectionDigest",
                  "generation",
                  "selectedSubjectDigest",
                  "conflictSetDigest",
                  "catalogBindingDigest",
                  "catalogRevisionDigest",
                  "publisherPolicyDigest",
                  "publisherBindingDigest",
                  "reviewerPolicyDigest"
                ],
                "properties": {
                  "selectionDigest": {
                    "$ref": "#/$defs/digest"
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "selectedSubjectDigest": {
                    "$ref": "#/$defs/digest"
                  },
                  "conflictSetDigest": {
                    "$ref": "#/$defs/digest"
                  },
                  "catalogBindingDigest": {
                    "$ref": "#/$defs/digest"
                  },
                  "catalogRevisionDigest": {
                    "$ref": "#/$defs/digest"
                  },
                  "publisherPolicyDigest": {
                    "$ref": "#/$defs/digest"
                  },
                  "publisherBindingDigest": {
                    "$ref": "#/$defs/digest"
                  },
                  "reviewerPolicyDigest": {
                    "$ref": "#/$defs/digest"
                  }
                }
              }
            }
          }
        }
      }
    },
    "cohortProjection": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "appVersion",
        "bundleDigest",
        "manifestDigest",
        "publisherId",
        "catalogId",
        "reviewDigest",
        "targetStability",
        "targetBaseline",
        "minimumContractVersion",
        "maximumTestedContractVersion",
        "requiredCapabilities",
        "optionalCapabilities",
        "experimentalCapabilitiesAccepted",
        "sourceAuthority",
        "sourceAuthorityRoot",
        "sourceEvidenceDigest",
        "fixtureOnly",
        "requiredForRelease",
        "subjectDigest",
        "signedProjection",
        "originalSource",
        "originalCatalogSource",
        "originalInventorySource"
      ],
      "properties": {
        "appId": {
          "$ref": "#/$defs/id"
        },
        "appVersion": {
          "$ref": "#/$defs/id"
        },
        "bundleDigest": {
          "$ref": "#/$defs/digest"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "publisherId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "catalogId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "reviewDigest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "targetStability": {
          "enum": [
            "legacy",
            "stable",
            "experimental"
          ]
        },
        "targetBaseline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^1\\.(?:0|[1-9][0-9]*)$"
            }
          ]
        },
        "minimumContractVersion": {
          "type": "integer",
          "minimum": 1
        },
        "maximumTestedContractVersion": {
          "type": "integer",
          "minimum": 1
        },
        "requiredCapabilities": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "optionalCapabilities": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "experimentalCapabilitiesAccepted": {
          "type": "boolean"
        },
        "sourceAuthority": {
          "enum": [
            "federated-catalog",
            "first-party-release",
            "fixture",
            "maintenance-app-products",
            "third-party-pilot"
          ]
        },
        "sourceAuthorityRoot": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "sourceEvidenceDigest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "fixtureOnly": {
          "type": "boolean"
        },
        "requiredForRelease": {
          "type": "boolean"
        },
        "subjectDigest": {
          "$ref": "#/$defs/digest"
        },
        "signedProjection": {
          "type": "object"
        },
        "originalSource": {
          "type": "object"
        },
        "originalCatalogSource": {
          "type": [
            "object",
            "null"
          ]
        },
        "originalInventorySource": {
          "type": "object"
        }
      }
    }
  }
}
