{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public ecosystem site bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "snapshotId",
    "mode",
    "asOf",
    "authentication",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "public-ecosystem-site-bundle"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "production",
        "demo"
      ]
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "authentication": {
      "const": "not-established"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "digest"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9./_-]*$",
            "maxLength": 220
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4194304
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
